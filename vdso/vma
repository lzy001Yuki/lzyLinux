< static vm_fault_t vtask_fault(const struct vm_special_mapping *sm,
< 		      struct vm_area_struct *vma, struct vm_fault *vmf) 
< {
< 	struct mm_struct *mm = vma->vm_mm;
< 	struct page *page;
< 	struct kernel_task_info* ktask_info;
< 	page = mm->vtask_page;
< 	if (!page) {
< 		page = 	alloc_page(GFP_KERNEL);
< 		if (!page) {
< 			return -ENOMEM;
< 		}
< 		mm->vtask_page = page;
< 		ktask_info = kmap_local_page(page);
< 		ktask_info->pid = current->pid;
< 		ktask_info->task_struct_ptr = current;
< 		kunmap_local(ktask_info);
< 	}
< 	get_page(page);
<     vmf->page = page;
< 	return VM_FAULT_SIGBUS;
< }
